  updatedAt DateTime @updatedAt

  @@index([eventId, status, category])
  @@index([weddingId, status, category])
  @@map("budget_items")
}

// Guest model
model Guest {
  id                      String     @id @default(cuid())
  name                    String
  firstName               String?
  lastName                String?
  email                   String?
  phone                   String?
  status                  String     @default("PENDING")
  isAttending             Boolean?
  tableId                 String?
  table                   Table?     @relation(fields: [tableId], references: [id], onDelete: SetNull)
  weddingId               String?
  wedding                 Wedding?   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  eventId                 String?
  event                   Event?     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  householdId             String?
  household               Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  dietaryRestrictions     String? // Rodzaj diety (wegetariańska, bezglutenowa, etc.)
  seatingNotes            String? // Uwagi dotyczące usadzenia gościa
  seatingPreference       String? // Preferencje usadzenia / tekst na winietkę
  accommodationPreference String? // Preferencje noclegowe (szczegóły)
  alcoholPreference       String? // Preferencje alkoholowe
  invitationToken         String?    @unique // Token do zaproszenia RSVP
  needsHotel              Boolean? // Czy gość potrzebuje hotelu
  needsTransport          Boolean? // Czy gość potrzebuje transportu
  transportDetails        String? // Gdzie / adres (gdy wymaga transportu)
  foodPreference          String? // Preferencje żywieniowe (rodzaj diety)
  allergies               String? // Alergie
