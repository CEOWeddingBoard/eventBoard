model VenueReservation {
  id                   String            @id @default(cuid())
  venueId              String
  venue                Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  eventId              String?           @unique
  event                Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  hallId               String?
  hall                 VenueHall?        @relation(fields: [hallId], references: [id], onDelete: SetNull)
  basePackageId        String?
  basePackage          VenueMenuPackage? @relation(fields: [basePackageId], references: [id], onDelete: SetNull)
  accessTokenHash      String            @unique
  accessTokenExpiresAt DateTime?
  isPremiumUnlocked    Boolean           @default(false)
  menuCompleted        Boolean           @default(false)
  seatingCompleted     Boolean           @default(false)
  scheduleCompleted    Boolean           @default(false)
  guestsCompleted      Boolean           @default(false)
  couplePortalConfig   String?
  linkCodeHash         String?           @unique
  linkCodeExpiresAt    DateTime?
  linkedAt             DateTime?
  status               String            @default("PENDING_ACTIVATION")
  weddingDate          DateTime
  coupleEmail          String
  coupleName           String?
  couplePhone          String?
  internalNotes        String?
  source               String?
  guestCountEstimate   Int?
  guestCountConfirmed  Int?
  estimatedTotalCost   Float?
  finalTotalCost       Float?
  currency             String            @default("PLN")
  seatingLockAt        DateTime?
  seatingLockedAt      DateTime?
  confirmedAt          DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  activatedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  roomLayout String?

  clientGuests        VenueClientGuest[]
  menuSelection       WeddingMenuSelection?
  scheduleItems       VenueClientScheduleItem[]
  seatingExport       GuestSeatingExport?
  paymentInstallments VenuePaymentInstallment[]
  notes               VenueReservationNote[]
  activities          VenueReservationActivity[]
  quotes              VenueQuote[]
  correctionRequests  VenueModuleCorrectionRequest[]
  contracts           Contract[]
  messages            VenueMessage[]

  leads    VenueLead[]
  invoices VenueInvoice[]
  shifts   VenueStaffShift[]
  reviews  VenueReview[]

  @@index([venueId, weddingDate])
  @@index([venueId, status])
  @@map("venue_reservations")
}

