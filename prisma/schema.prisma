/// Link decyzyjny dla osoby BEZ konta w systemie.
///
/// Wcześniej event miał dokładnie jeden taki link (`Event.clientLinkTokenHash`)
/// i zawsze w roli klienta. Przy jednym przyjęciu decyzje podejmuje jednak
/// więcej osób z zewnątrz: zamawiający, wedding planner prowadzący przyjęcie
/// w imieniu klienta, czasem podwykonawca. Każde z nich potrzebuje własnego
/// linku i widzi wyłącznie kroki swojej roli — inaczej planner zamykałby kroki
/// zamawiającego i odwrotnie.
model EventAccessLink {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Rola kroku procesu, którą ten link obsługuje (CLIENT, PLANNER, własna).
  role  String
  /// Do rozpoznania w panelu: „Państwo Kowalscy", „Ania — planner".
  label String
  email String?

  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId])
  @@map("event_access_links")
}
