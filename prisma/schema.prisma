// Full Prisma schema for Wedding Planner App

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  password             String
  name                 String?
  clerkId              String?   @unique
  role                 String    @default("STAFF") // ADMIN | STAFF
  isActive             Boolean   @default(true)
  metadataJson         String? // JSON: billing/trial (stripeCustomerId, plan, trialEndsAt...)
  // Akceptacja regulaminu — wersja i moment. Brak/nieaktualna = brama akceptacji.
  acceptedTermsVersion String?
  acceptedTermsAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  weddings            Wedding[]
  participants        WeddingParticipant[]
  tasks               Task[]
  createdEvents       Event[]
  eventParticipants   EventParticipant[]
  googleCalendars     GoogleCalendarConnection[]
  organizationMembers OrganizationMember[]
  ownedOrganizations  Organization[]             @relation("OrganizationOwner")

  @@map("users")
}

// Blokady terminów organizacji (kalendarz EventBoard)
model OrgBlockedDate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  date           DateTime
  reason         String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, date])
  @@index([organizationId, date])
  @@map("org_blocked_dates")
}

// Szablony agendy i menu organizacji (reuse między eventami)
model OrgTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  kind           String       @default("AGENDA") // AGENDA | MENU
  contentJson    String // { schedule:[{time,title,description,location}], menuVariants:[{label,courses:[...]}] }
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, kind])
  @@map("org_templates")
}

// Powiadomienia in-app organizacji
model OrgNotification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String       @default("INFO") // INFO | CLIENT_REPLY | PAYMENT | DEADLINE | LEAD
  title          String
  body           String?
  link           String?
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([organizationId, read, createdAt])
  @@map("org_notifications")
}

// Płatności klienta — manualny cashflow (bez bramki płatniczej)
model EventPayment {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label     String // np. "Zadatek", "Rata 1", "Dopłata końcowa"
  amount    Float
  dueDate   DateTime?
  status    String    @default("PENDING") // PENDING | PAID
  paidAt    DateTime?
  method    String? // gotówka / przelew / karta
  notes     String?
  createdAt DateTime  @default(now())

  @@index([eventId, status])
  @@map("event_payments")
}

// Zapytania ofertowe z publicznego profilu organizatora
model OrgLead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  eventDate      DateTime?
  guestCount     Int?
  message        String?
  status         String       @default("NEW") // NEW | CONTACTED | WON | LOST
  createdAt      DateTime     @default(now())

  @@index([organizationId, status])
  @@map("org_leads")
}

// =============================================================================
// EVENT CLOUD: Organizacja (firma / sala / biznes eventowy)
// =============================================================================

model Organization {
  id                     String    @id @default(cuid())
  name                   String
  slug                   String    @unique
  ownerId                String // User.id właściciela
  owner                  User      @relation("OrganizationOwner", fields: [ownerId], references: [id])
  logo                   String?
  address                String?
  phone                  String?
  email                  String?
  // Pola profilu publicznego (/org/<slug>) — strona odpytywała je,
  // zanim istniały w modelu, przez co render kończył się błędem 500.
  city                   String?
  postalCode             String?
  website                String?
  description            String?
  capacity               Int?
  priceRange             String?
  plan                   String    @default("FREE") // FREE | BASIC | PRO | ENTERPRISE
  planExpires            DateTime?
  // Limity licencji ustawiane per przestrzeń przez admina platformy.
  // null = domyślny limit z planu. SERVICE nie liczy się do żadnego.
  maxAdmins              Int?
  maxUsers               Int?
  /// Limit podłączonych kalendarzy Google. null = limit z planu.
  maxGoogleCalendars     Int?
  // Własne role operacyjne tej przestrzeni (poza stałymi Manager/Kuchnia/...).
  // JSON: [{value, label}]. Admin platformy definiuje je per klient.
  customRolesJson        String?
  // Uprawnienia modułowe per rola: { [roleValue]: { [moduleKey]: none|view|edit } }.
  modulePermissionsJson  String?
  // Powiadomienia o krokach czekających na akceptację.
  notifyDaysBefore       Int?      @default(7) // ile dni przed eventem wysyłać
  notifyEmail            Boolean   @default(true)
  notifySms              Boolean   @default(false)
  // Notatka admina platformy o kliencie (wewnętrzna) + archiwizacja przestrzeni.
  adminNote              String?
  /// Osoba kontaktowa po stronie klienta — kto faktycznie odbiera telefon.
  contactPerson          String?
  contactPhone           String?
  archivedAt             DateTime?
  // Lekki branding per klient — kolor przewodni i logo (URL).
  brandColor             String?
  brandLogoUrl           String?
  // Ręczne śledzenie płatności klienta przez admina platformy (SaaS, bez Stripe).
  billingPaidUntil       DateTime?
  billingNote            String?
  dashboardShortcutsJson String? // JSON: [{label, href}] skróty na pulpicie

  members                 OrganizationMember[]
  events                  Event[]
  venues                  Venue[]
  categories              EventCategory[]
  blockedDates            OrgBlockedDate[]
  templates               OrgTemplate[]
  notifications           OrgNotification[]
  googleCalendars         GoogleCalendarConnection[]
  adminNotes              OrgAdminNote[]
  staff                   OrgStaff[]
  leads                   OrgLead[]
  agendaTemplates         AgendaTemplate[]
  agendaDocumentTemplates AgendaDocumentTemplate[]
  objectTypes             OrganizationObjectType[]
  workflows               OrganizationWorkflow[]
  menuParserConfig        MenuParserConfig?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

// Konfiguracja parsera menu (na poziomie organizacji). Reguły w JSON:
// { sections: [{match, courseType}], variantMarkers: [...], bulletChars: "*-•",
//   ignoreContains: [...] } — definiuje, od jakich słów kluczowych powstają
// sekcje menu przy wklejaniu tekstu.
/// Trwałe liczniki prób logowania i resetu hasła. Licznik w pamięci procesu
/// nie działa przy więcej niż jednej instancji aplikacji.
model RateLimitHit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limit_hits")
}

/// Notatki admina platformy o kliencie — dziennik, nie jedno pole tekstowe.
/// Z nich wiadomo, czego klienci naprawdę potrzebują i w którą stronę rozwijać
/// produkt; pojedyncza notatka nadpisywana za każdym razem tę wiedzę gubiła.
model OrgAdminNote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Kto dopisał — konto admina platformy.
  authorId       String?
  authorName     String?
  /// Rodzaj wpisu: UWAGA | POMYSL | PROBLEM | USTALENIE
  kind           String       @default("UWAGA")
  content        String
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@map("org_admin_notes")
}

/// Personel obiektu — ludzie BEZ kont w systemie.
/// Kelner czy kucharz nie musi się logować, żeby trafić na obsadę przyjęcia
/// i do agendy. Konta zakłada się tylko tym, którzy realnie pracują w panelu.
/// (Modele VenueStaff/VenueStaffShift to zaszłość po produkcie weselnym —
/// były przypięte do Venue i do martwego modelu rezerwacji.)
model OrgStaff {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// Rola operacyjna — te same wartości co role kroków procesu.
  role           String       @default("STAFF")
  phone          String?
  note           String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  obsady EventStaff[]

  @@index([organizationId, isActive])
  @@map("org_staff")
}

/// Obsada konkretnego przyjęcia: kto pracuje, od której i w jakiej roli.
model EventStaff {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staffId   String
  staff     OrgStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// Rola na tym przyjęciu — bywa inna niż domyślna (kelner jako koordynator).
  role      String?
  startTime String?
  endTime   String?
  note      String?
  createdAt DateTime @default(now())

  @@unique([eventId, staffId])
  @@index([eventId])
  @@map("event_staff")
}

model MenuParserConfig {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rulesJson      String       @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("menu_parser_configs")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("STAFF") // OWNER | MANAGER | STAFF | VIEWER | SERVICE
  permissions    String? // JSON z uprawnieniami per moduł (nadpisuje role)
  // Poziom dostępu: admin może nadawać uprawnienia i zarządzać zespołem.
  isAdmin        Boolean      @default(false)
  // Role operacyjne (kuchnia, kelner, bar, manager…) — użytkownik może mieć
  // ich WIELE. JSON: string[]. Zasilają kroki procesu (kto wypełnia/akceptuje).
  rolesJson      String       @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@map("organization_members")
}

// Kategorie eventów definiowane przez organizatora (np. "Chrzciny", "Bankiet firmowy")
model EventCategory {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String // "Chrzciny", "Bankiet firmowy"
  icon             String? // ikona (Lucide icon name)
  color            String? // hex kolor kategorii
  modulesJson      String? // JSON: ["guests_full","menu","schedule","budget"]
  defaultsJson     String? // JSON: { guestListMode: "ALLERGENS_ONLY", ... }
  customFieldsJson String? // JSON: [{key, label, type: "text"|"number"|"date"|"select", options?, required?}]
  agendaTemplateId String? // ID szablonu agendy do auto-wypełnienia
  isSystem         Boolean      @default(false) // true dla predefiniowanych (WEDDING, COMMUNION...)

  events          Event[]
  agendaTemplates AgendaTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("event_categories")
}

// Szablony agendy z wizualnym builderem (drag-and-drop)
model AgendaTemplate {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       EventCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  sectionsJson   String // JSON: [{id, title, description?, fields: [{key, label, type, required?, placeholder?, llmPrompt?}]}]
  isDefault      Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([categoryId])
  @@map("agenda_templates")
}

// Szablony dokumentów agendy (visual layout builder - jak Jasper Reports)
model AgendaDocumentTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  pagesJson      String // JSON: [{blocks: [{id, type, props, slots: [{id, fieldKey?, placeholder?, llmPrompt?, style?}]}]}]
  settingsJson   String? // JSON: {pageFormat: "A4"|"Letter", orientation: "portrait"|"landscape", margins, fonts, colors}
  isDefault      Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("agenda_document_templates")
}

// Połączenie z Google Calendar (OAuth) – jeden na użytkownika
/// Podłączony kalendarz Google. Jedna przestrzeń może mieć ich wiele — obiekt
/// zwykle prowadzi kilka kalendarzy na różnych kontach (sala, właściciel,
/// koordynator). Każde połączenie ma swój kolor na grafiku i może być
/// przypisane do konkretnej sali.
model GoogleCalendarConnection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Kto podłączył konto — token należy do tej osoby, ale kalendarz do przestrzeni.
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Nazwa widoczna na grafiku, np. „Kalendarz sali”, „Kalendarz Marka”.
  label          String       @default("Kalendarz Google")
  /// Kolor pozycji na grafiku (hex). Bez tego nie da się odróżnić źródeł.
  color          String       @default("#0ea5e9")
  /// Sala, której dotyczy ten kalendarz. Null = rezerwacje całego obiektu.
  venueHallId    String?
  refreshToken   String
  accessToken    String?
  tokenExpiresAt DateTime?
  calendarId     String? // np. "primary" lub id kalendarza
  /// Wyłączone połączenie zostaje z tokenem, ale znika z grafiku.
  isActive       Boolean      @default(true)
  lastSyncAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, isActive])
  @@index([userId])
  @@map("google_calendar_connections")
}

// Wedding/Event model (using Wedding as the main model)
model Wedding {
  id                  String   @id @default(cuid())
  name                String
  ceremonyDate        DateTime
  receptionLocation   String?
  targetBudget        Float?
  budgetCurrency      String?  @default("PLN")
  estimatedGuestCount Int?
  style               String?
  priorities          String? // JSON array stored as string
  notes               String?
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  participants        WeddingParticipant[]
  tasks               Task[]
  budget              BudgetItem[]
  guests              Guest[]
  vendors             Vendor[]
  vendorDocuments     VendorDocument[]
  tables              Table[]
  seatingRules        SeatingRule[]
  households          Household[]
  planVersions        WeddingPlanVersion[]
  invitationTemplates InvitationTemplate[]

  @@map("weddings")
}

// Event model (for backward compatibility)
model Event {
  id                    String                 @id @default(cuid())
  name                  String
  date                  DateTime
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId        String?
  organization          Organization?          @relation(fields: [organizationId], references: [id])
  categoryId            String?
  category              EventCategory?         @relation(fields: [categoryId], references: [id])
  customFieldValuesJson String? // JSON: wartości pól zdefiniowanych dla typu eventu
  workflowId            String?
  workflow              OrganizationWorkflow?  @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  // Sala, w której odbywa się przyjęcie. Obiekt z kilkoma salami prowadzi
  // równoległe imprezy tego samego dnia, więc kalendarz i lista muszą
  // rozróżniać, która sala jest zajęta.
  hallId                String?
  hall                  VenueHall?             @relation(fields: [hallId], references: [id], onDelete: SetNull)
  workflowStageId       String? // DEPRECATED: zachowane dla kompatybilności, użyj processState
  workflowHistory       EventWorkflowHistory[]
  processState          EventProcessState?
  staff                 EventStaff[]
  agendaData            EventAgendaData?
  accessLinks           EventAccessLink[]
  // Ostatnie wysłane przypomnienie o kroku czekającym na akceptację (dedup).
  approvalReminderAt    DateTime?
  modulesOverrideJson   String? // JSON: nadpisanie modułów per event (null = użyj kategorii)
  brideName             String?
  groomName             String?
  partnerEmail          String?
  targetBudget          Float?
  budgetCurrency        String?                @default("PLN")
  estimatedGuestCount   Int?
  style                 String?
  priorities            String? // JSON array stored as string

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tasks               Task[]
  budget              BudgetItem[]
  guests              Guest[]
  vendors             Vendor[]
  vendorDocuments     VendorDocument[]
  tables              Table[]
  rules               SeatingRule[]
  roomElements        RoomElement[]
  dayScheduleItems    DayScheduleItem[]
  menuCourses         MenuCourse[]
  wishes              Wish[]
  photos              Photo[]
  sharedChatbotAgents SharedChatbotAgent[]
  participants        EventParticipant[]
  partnerInvites      EventPartnerInvite[]
  partnerLinkAccess   EventPartnerLinkAccess[]
  venueReservations   VenueReservation[]
  boardLinks          EventBoardLink[]
  menuVariants        MenuVariant[]
  agendaApprovals     AgendaApproval[]
  roles               Role[]
  voiceNotes          VoiceNote[]
  payments            EventPayment[]
  messages            EventMessage[]
  widgets             EventWidget[]

  // RSVP configuration stored as JSON string
  rsvpFieldsConfig String?

  // Public wedding website / guest portal configuration
  publicSlug            String? @unique
  heroImageUrl          String?
  guestPhotosFolderUrl  String?
  description           String?
  dressCode             String?
  ceremonyLocationName  String?
  ceremonyLocationUrl   String?
  receptionLocationName String?
  receptionLocationUrl  String?
  mapLocationUrl        String?
  guestPortalEnabled    Boolean @default(false)

  // SMS task reminders (Faza 4)
  notificationPhone         String?
  notificationDailyEnabled  Boolean @default(false)
  notificationWeeklyEnabled Boolean @default(false)

  // Typ eventu — konfiguruje UI i dostępne sekcje
  eventType String @default("WEDDING") // WEDDING | COMMUNION | CHRISTMAS_EVE | CORPORATE | OTHER

  // Agenda imprezy (szablon docx restauracji)
  organizerName     String? // Organizator (klient / firma)
  responsiblePerson String? // Odpowiedzialny za event (inny niż twórca)
  eventEndTime      DateTime? // Godzina zakończenia imprezy
  occasionLabel     String? // Okoliczność wolnym tekstem ("bal", "studniówka")
  scenarioNotes     String? // Scenariusz — uwagi techniczne / sprzęt / logistyka
  isWedding         Boolean   @default(false) // Wesele → Wedding Board dla pary (link + PIN)

  // WeddingBoard — token dla pary gdy isWedding=true
  weddingBoardToken String? @unique

  // Portal decyzyjny klienta (eventy nie-weselne) — link EventBoard
  clientLinkTokenHash     String?   @unique
  clientLinkExpiresAt     DateTime?
  clientReviewedAt        DateTime?
  clientFeedback          String?
  clientWorkflowStatus    String    @default("MENU_DRAFT") // MENU_DRAFT | MENU_SENT | MENU_SUBMITTED | ORGANIZER_REVIEW | NEXT_STEP
  clientMenuSelectionJson String? // JSON: { variantId, guests }[]
  clientNextStepTitle     String?
  clientNextStepMessage   String?
  clientNextStepSentAt    DateTime?

  // Status eventu
  status String @default("DRAFT") // DRAFT | CONFIRMED | COMPLETED | ARCHIVED

  // Kosztorys i deadline'y klienta
  quoteJson           String? // JSON: { items: [{label, amount}], notes }
  menuDeadlineAt      DateTime? // termin wyboru menu przez klienta
  guestListDeadlineAt DateTime? // termin dostarczenia listy gości

  // Tryb listy gości — pełna lista lub tylko alergeny
  guestListMode String @default("FULL") // FULL | ALLERGENS_ONLY

  // Google Calendar – id wydarzenia w Google (główne wesele)
  googleCalendarEventId String?
  calendarFeedToken     String? @unique // token do subskrypcji kalendarza (feed iCal)

  @@index([userId, date])
  @@index([publicSlug])
  @@index([eventType])
  @@map("events")
}

// Organizacja dnia wesela: co, gdzie, o której
model DayScheduleItem {
  id            String    @id @default(cuid())
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startTime     DateTime
  endTime       DateTime?
  title         String
  description   String?
  location      String?
  sortOrder     Int       @default(0)
  googleEventId String? // id wydarzenia w Google Calendar

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("day_schedule_items")
}

model EventBoardLink {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label     String
  url       String
  icon      String? // map | music | camera | menu | calendar | link
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("event_board_links")
}

// Menu weselne: pozycje (zupy, dania, desery itd.)
model MenuCourse {
  id          String  @id @default(cuid())
  eventId     String
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  courseType  String // APPETIZER, SOUP, MAIN, DESSERT, CAKE, DRINKS, OTHER
  description String?
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("menu_courses")
}

model MenuVariant {
  id             String              @id @default(cuid())
  eventId        String
  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label          String // "MENU A", "MENU B", "MENU C", "MENU WIGILIJNE"
  description    String? // opis tekstowy wariantu
  imageUrl       String? // skan menu (URL lub base64 data URL)
  notes          String? // uwagi, alergeny itp.
  pricePerPerson Float? // cena za osobę dla całego wariantu (np. bufet 250 zł/os.)
  courses        MenuVariantCourse[]
  sortOrder      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@map("menu_variants")
}

model MenuVariantCourse {
  id            String      @id @default(cuid())
  menuVariantId String
  menuVariant   MenuVariant @relation(fields: [menuVariantId], references: [id], onDelete: Cascade)
  name          String
  courseType    String // APPETIZER, SOUP, MAIN, DESSERT, CAKE, OTHER
  description   String?
  allergens     String? // JSON: { vege: bool, gluten: bool, bezgluten: bool, inne: string }
  priceBase     Float? // cena bazowa (za osobę)
  priceExtra    Float? // dopłata do wariantu
  portions      Int? // liczba porcji (bufet)
  approved      Boolean     @default(false) // pozycja zatwierdzona
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("menu_variant_courses")
}

// Uniwersalne typy obiektów konfigurowane przez organizację.
model OrganizationObjectType {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  icon           String?
  fieldsJson     String // JSON: [{key,label,type,required,options}]
  // JSON: ["EVENT","PORTAL","AGENDA","DOCUMENT","LEAD","FINANCE"] — kartoteki, w których obiekt jest widoczny
  visibleInJson  String?
  // Opcjonalne powiązanie z procesem — obiekt zbiera dane dla konkretnego workflow
  workflowId     String?
  workflow       OrganizationWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  isSystem       Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([organizationId])
  @@index([workflowId])
  @@map("organization_object_types")
}

// Konfigurowalne procesy obsługi eventów/transakcji.
model OrganizationWorkflow {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  eventType      String?
  stagesJson     String                   @default("[]") // DEPRECATED: zastąpione przez WorkflowNode
  isDefault      Boolean                  @default(false)
  events         Event[]
  nodes          WorkflowNode[]
  objectTypes    OrganizationObjectType[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([organizationId, eventType])
  @@map("organization_workflows")
}

// Węzły procesu (drzewo decyzyjne zastępujące płaskie stagesJson)
model WorkflowNode {
  id                String               @id @default(cuid())
  workflowId        String
  workflow          OrganizationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  nodeType          String               @default("ACTION") // ACTION | DECISION | PARALLEL | END
  actionType        String               @default("NONE") // NONE | CLIENT_FORM | MENU_SELECTION | APPROVAL | PAYMENT | DOCUMENT | AGENDA | SEND_MESSAGE
  assigneeRole      String               @default("MANAGER") // OWNER | MANAGER | STAFF | CLIENT | BOTH
  sortOrder         Int                  @default(0)
  color             String?
  // JSON: [{sourceKey, targetAgendaKey, transform?}]
  fieldMappingsJson String               @default("[]")
  // JSON: [{label, conditionType, conditionValue?, nextNodeId}] — dla węzłów DECISION
  conditionsJson    String               @default("[]")
  // ID następnego węzła dla węzłów liniowych ACTION
  nextNodeId        String?
  isStart           Boolean              @default(false)
  // Sposób wyboru menu na kroku MENU_SELECTION:
  // WHOLE_VARIANT — klient bierze gotowy zestaw, PER_DISH — składa go z dań.
  menuMode          String?
  // Kto wypełnia krok, a kto go akceptuje — definiowane na etapie procesu.
  // Gdy null, wsteczna zgodność: wypełnia = assigneeRole, brak osobnej akceptacji.
  fillRole          String?
  approveRole       String?
  // Definicja pól kroku: [{key, label, type, targetAgendaKey, required?, scheduleLine?}]
  // type: text | textarea | time | date | number | select. scheduleLine=true →
  // wartość-czas + nazwa kroku tworzą pozycję harmonogramu w agendzie.
  fieldsJson        String               @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowId, sortOrder])
  @@map("workflow_nodes")
}

model EventWorkflowHistory {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fromStage String?
  toStage   String
  note      String?
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@map("event_workflow_history")
}

model AgendaApproval {
  id         String    @id @default(cuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  section    String // SCHEDULE, MENU, GUESTS, KITCHEN, GENERAL
  approvedBy String? // userId — null dopóki niezaakceptowane
  approvedAt DateTime?
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  comment    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([eventId, section])
  @@map("agenda_approvals")
}

// Stan instancji procesu na evencie (zastępuje workflowStageId)
model EventProcessState {
  id               String   @id @default(cuid())
  eventId          String   @unique
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  workflowId       String
  currentNodeId    String
  // JSON: string[] — ID ukończonych węzłów
  completedNodeIds String   @default("[]")
  // JSON: {nodeId: {completedAt, completedBy, role, data}} — dane zebrane przez każdy węzeł
  nodeDataJson     String   @default("{}")
  startedAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([workflowId])
  @@map("event_process_states")
}

// Ujednolicony magazyn danych agendy — wynik mapowania pól z węzłów procesu
model EventAgendaData {
  id        String   @id @default(cuid())
  eventId   String   @unique
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // JSON: {fieldKey: value} — płaski obiekt zbierający dane ze wszystkich ukończonych węzłów
  dataJson  String   @default("{}")
  updatedAt DateTime @updatedAt

  @@map("event_agenda_data")
}

model Role {
  id          String              @id @default(cuid())
  eventId     String
  event       Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String // OWNER, MANAGER, KITCHEN_CHIEF, STAFF
  label       String // "Właściciel", "Manager", "Szef Kuchni"
  isSystem    Boolean             @default(false) // OWNER — nieusuwalny
  permissions SectionPermission[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("roles")
}

model SectionPermission {
  id         String  @id @default(cuid())
  roleId     String
  role       Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  section    String // SCHEDULE, MENU, GUESTS, KITCHEN, VENDORS, SETTINGS, ANALYTICS
  canView    Boolean @default(false)
  canEdit    Boolean @default(false)
  canApprove Boolean @default(false)

  @@unique([roleId, section])
  @@map("section_permissions")
}

// Event participants (współpraca pary / planner na wydarzeniu Event)
model EventParticipant {
  id      String  @id @default(cuid())
  eventId String
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    String  @default("VIEWER") // COUPLE_SECONDARY, CO_ORGANIZER, WEDDING_PLANNER, VIEWER
  roleId  String? // FK → Role (nadpisuje legacy role string)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
  @@map("event_participants")
}

// Zaproszenie partnera zanim założy konto (e-mail).
model EventPartnerInvite {
  id         String    @id @default(cuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email      String
  role       String    @default("COUPLE_SECONDARY")
  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?

