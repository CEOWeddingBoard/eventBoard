# Database (schema.prisma używa SQLite – URL musi zaczynać się od file:)
DATABASE_URL="file:./dev.db"
# Dla PostgreSQL: zmień provider w prisma/schema.prisma na "postgresql" i ustaw np.:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wedding_planner?schema=public"

# Wymagane na produkcji (link partnera, RSVP, maile). Na Railway: URL serwisu, np. https://xxx.up.railway.app
NEXT_PUBLIC_APP_URL=https://www.twoja-domena.pl
# URL aplikacji WeddingBoard — gdy pusta, linki wskazują na tę samą domenę (/wedding/[token])
NEXT_PUBLIC_WEDDINGBOARD_URL=https://weddingboard.pl

# Analytics (Plausible) — statystyki odwiedzin na produkcji
# 1. Załóż konto na https://plausible.io i dodaj domenę weddingboard.pl
# 2. Ustaw zmienną w Railway (Variables) — bez niej skrypt się nie ładuje
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=weddingboard.pl
# Opcjonalnie wymuś host w linkach (np. www.weddingboard.pl gdy apex DNS jeszcze na home.pl)
# NEXT_PUBLIC_APP_CANONICAL_HOST=www.weddingboard.pl
# Szczegóły: docs/WDROZENIE-EMAIL-POWITALNY.md

# Link partnerski (PIN + sesja bez logowania). Produkcja: ustaw długi losowy sekret.
# PARTNER_ACCESS_SECRET=

# E-mail (Resend) — powitanie, zaproszenia gości, partner
RESEND_API_KEY=re_...
RESEND_FROM="Wedding Board <no-reply@twoja-domena.pl>"
# AI Configuration (generowanie zadań: „Wygeneruj plan zadań AI”)
# Provider: mock | openai | deepseek (szczegóły w docs/KONFIGURACJA-AI.md)
AI_PROVIDER=mock
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
# Opcjonalnie – nazwa modelu (domyślnie: openai=gpt-4o-mini, deepseek=deepseek-chat czyli DeepSeek-V3.2)
# OPENAI_TASKS_MODEL=gpt-4o-mini
# DEEPSEEK_TASKS_MODEL=deepseek-chat
# Dla analizy obrazu (wzór zaproszenia) – tylko DeepSeek: gdy API udostępni model vision, ustaw np.:
# DEEPSEEK_VISION_MODEL=deepseek-vl

# --- OpenRouter (Papeteria) — w Railway ustaw minimum OPENROUTER_API_KEY ---
OPENROUTER_API_KEY=sk-or-v1-...
AI_IMAGE_PROVIDER=openrouter
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image-preview
# Dedykowany łańcuch modeli papeterii (opcjonalnie, po przecinku):
# OPENROUTER_STATIONERY_IMAGE_MODEL=google/gemini-3.1-flash-image-preview,black-forest-labs/flux.2-pro
OPENROUTER_INVITATION_MODEL=google/gemini-2.5-flash
# $5 kredytów wystarczy na testy. STATIONERY_SKIP_AI_IMAGE=true = wektor + typografia (bez AI).

# Payments (Stripe) — produkcja Live (weddingboard.pl)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # Webhook: https://weddingboard.pl/api/webhooks/stripe
# Wymagane na produkcji — cena miesięczna 59 PLN z Dashboard (Products):
# STRIPE_PRICE_ID=price_1TdVhGGMuGF6sdAPZp392BaW
# Panel organizatora (sala weselna) — 150 PLN miesięcznie (gdy włączysz płatność):
# STRIPE_VENUE_PRICE_ID=price_...
# Domyślnie panel organizatora jest za darmo. Ustaw true, aby wymagać subskrypcji Stripe:
# VENUE_BILLING_ENABLED=false
# Opcjonalnie: Payment method configuration (karty + BLIK) z Dashboard
# STRIPE_PAYMENT_METHOD_CONFIGURATION=pmc_...
# Opcjonalnie: Billing Portal configuration (faktury, zmiana karty)
# STRIPE_BILLING_PORTAL_CONFIGURATION=bpc_...
# Opcjonalna stopka faktury (zwolnienie VAT art. 113); domyślna w src/lib/billing.ts
# STRIPE_INVOICE_VAT_FOOTER=

# Cron auth token (required for /api/cron/* endpoints in production)
CRON_SECRET=losowy-bardzo-dlugi-sekret

# Ebook lead magnet — eksport CSV leadów (GET /api/ebook-leads/export?key=... lub nagłówek X-Ebook-Export-Key)
EBOOK_EXPORT_SECRET=losowy-bardzo-dlugi-sekret-ebook-export

# Storage (AWS S3 / Cloudflare R2)
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_BUCKET_NAME=wedding-planner-assets

# ── Monitoring i alerty (Faza 5) ──────────────────────────────────────────
# Sentry — bez DSN monitoring jest wyłączony, aplikacja działa normalnie.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Alert o błędzie 5xx trafia tutaj (e-mail przez Resend).
ALERT_EMAIL=
# Ten sam błąd nie powtórzy alertu przez tyle minut (domyślnie 30).
ALERT_DEDUP_MINUTES=30

AUTH_SESSION_SECRET=

# ── SMS (Twilio) — przypomnienia z cronów ────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Ograniczenie dostępu do środowiska ───────────────────────────────────
# Lista adresów IP oddzielona przecinkami. Ustawiona w produkcji = tylko te
# adresy wejdą do aplikacji (poza webhookami). Pusta = bez ograniczeń.
ALLOWED_IPS=

# ── Tryb deweloperski ────────────────────────────────────────────────────
# true = getCurrentUser zwraca użytkownika testowego BEZ sprawdzania sesji.
# W produkcji zabronione — aplikacja rzuci wyjątkiem przy starcie żądania.
NEXT_PUBLIC_DEV_MODE=

# ── Konta do testów E2E (tylko CI) ───────────────────────────────────────
# Bez nich e2e/tenant-isolation.spec.ts i e2e/permissions.spec.ts same się
# pomijają — przechodzą, ale niczego nie pilnują.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_NONE_EMAIL=
E2E_NONE_PASSWORD=
E2E_VIEW_EMAIL=
E2E_VIEW_PASSWORD=
E2E_EDIT_EMAIL=
E2E_EDIT_PASSWORD=
