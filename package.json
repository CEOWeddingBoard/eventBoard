{
  "name": "eventboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0 <22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "clean": "npx --yes rimraf .next .next-dev",
    "dev:clean": "npm run clean && npm run dev",
    "dev:fresh": "scripts\\fix-next-eperm.bat",
    "build": "next build",
    "build:railway": "npm run build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "test": "jest --config jest.config.simple.js --passWithNoTests",
    "test:watch": "jest --config jest.config.simple.js --watch --passWithNoTests",
    "test:coverage": "jest --config jest.config.simple.js --coverage --passWithNoTests",
    "test:ci": "jest --config jest.config.simple.js --ci --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "db:reset:fresh": "node scripts/reset-db.js",
    "social:build-posts": "node scripts/build-instagram-posts.mjs",
    "social:logo": "node scripts/generate-instagram-logo.mjs"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
